# ==============================================================================
# AffiliateKage (影) - Environment Configuration
# ==============================================================================

# ==========================================
# LLM CONFIGURATION (Provider Agnostic)
# ==========================================
# LLM Provider Options: ollama | openrouter | openai | deepseek | groq
LLM_PROVIDER=ollama

# Model Identifier:
# - Ollama:     qwen3-coder:30b, llama3.3:70b, deepseek-r1:70b, etc.
# - OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-2.5-pro, openai/gpt-4o
# - OpenAI:     gpt-4o, o3-mini
LLM_MODEL=qwen3-coder:30b
OLLAMA_MODEL=qwen3-coder:30b

# Cloud LLM API Key (Required if using openrouter, openai, deepseek, or groq)
# LLM_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...

# Custom Base URL (Optional - for Groq, Together, vLLM, LocalAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ==========================================
# HEADLESS CMS / BACKEND API
# ==========================================
API_URL=https://api.yourdomain.com/api/admin
API_TOKEN=your_secret_admin_bearer_token_here

# ==========================================
# AMAZON ASSOCIATES AFFILIATE TAG
# ==========================================
AMAZON_AFFILIATE_TAG=yourtag-20

# ==========================================
# IMAGE GENERATION PROVIDER
# ==========================================
# Options:
#   comfyui   - Local GPU rendering with ComfyUI SDXL (Default, 100% free)
#   openai    - Cloud rendering with OpenAI DALL-E 3
#   stability - Cloud rendering with Stability AI SDXL
#   fallback  - Zero GPU / Zero API key: pulls high-res photo via DuckDuckGo
IMAGE_PROVIDER=comfyui

# ComfyUI Settings (Required if IMAGE_PROVIDER=comfyui)
COMFY_URL=http://127.0.0.1:8188
COMFY_START_CMD=cd ~/comfyui/ComfyUI && source venv/bin/activate && python main.py
COMFY_TIMEOUT=600
COMFY_STEPS=25
COMFY_MAX_RETRIES=3

# Optional Cloud Image API Keys (Used if IMAGE_PROVIDER is openai or stability)
# OPENAI_API_KEY=sk-...
# STABILITY_API_KEY=sk-...

# ==========================================
# CUSTOM STEALTH SCRAPER API MICROSERVICE
# ==========================================
CUSTOM_SCRAPER_API_URL=http://127.0.0.1:4000
